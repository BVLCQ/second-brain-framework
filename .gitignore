# ═══ VAULT — TUDO que é do dono mora aqui ═══
/vault/

# ═══ Config e estado da INSTÂNCIA (nunca commitados) ═══
.env
config/.env
config/brain.toml
config/watch.toml
config/.state.json
config/*.state.json.lock
config/.memory-state.json

# ═══ Inovação local: scripts nascidos na instância (graduam p/ upstream) ═══
scripts/local/

# Cópias do vault (backup local, backup pré-migração de IDs) — conteúdo do dono
brain-backup-*.zip
brain-pre-ids-migration-*.zip
# Vault demo arquivado pelo setup (brain setup, passo instancia) — conteúdo do dono
vault-demo-*/

# Sistema
.DS_Store
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# TUI opcional (venv criada por `./brain tui --setup`)
.venv-tui/
