{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task"
    ],
    "deny": [
      "Edit(/vault/PROCESSED/_ledger/**)",
      "Edit(/config/.env)",
      "Read(/config/.env)",
      "Edit(/.env)",
      "Read(/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(*--no-verify*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/brain agent permissions >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
