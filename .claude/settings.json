{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task"
    ],
    "deny": [
      "Edit(/vault/PROCESSED/_ledger/**)",
      "Edit(/config/.env)",
      "Read(/config/.env)",
      "Edit(/.env)",
      "Read(/.env)",
      "Read(**/config/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Bash(*cat *.env*)",
      "Bash(*cat ~/.ssh/*)",
      "Bash(*cat */.ssh/*)",
      "Bash(*cat ~/.aws/*)",
      "Bash(*cat */.aws/*)",
      "Bash(*cat ~/.config/gh/hosts.yml*)",
      "Bash(*cat */.config/gh/hosts.yml*)",
      "Bash(*cat ~/.netrc*)",
      "Bash(*cat */.netrc*)",
      "Bash(*cat ~/.gnupg/*)",
      "Bash(*cat */.gnupg/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(*--no-verify*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/brain agent permissions >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
