<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Decisor local (hs-decide-1-flash). O caminho entra no lugar de __BRAIN_DIR__ ao instalar.
     Este arquivo não é válido como está. Quem instala é o brain setup (passo memória);
     a receita manual está em guides/commands.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.segundo-cerebro.decider</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__BRAIN_DIR__/services/decider-serve.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAIN_DIR</key>
    <string>__BRAIN_DIR__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__BRAIN_DIR__/vault/logs/decider.log</string>
  <key>StandardErrorPath</key>
  <string>__BRAIN_DIR__/vault/logs/decider.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
