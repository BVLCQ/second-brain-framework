<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Watchdog dos serviços locais do Segundo Cérebro (services/watchdog.sh), no login e a cada 5 min.
     O caminho da instância entra no lugar do placeholder __BRAIN_DIR__ ao instalar — este arquivo não é
     válido como está. Passo a passo: guides/commands.md, seção "Serviços desta máquina".
     Pausar: touch ~/.brain-watchdog-off (apagar o arquivo retoma). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.segundo-cerebro.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__BRAIN_DIR__/services/watchdog.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__BRAIN_DIR__/vault/logs/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__BRAIN_DIR__/vault/logs/watchdog.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
