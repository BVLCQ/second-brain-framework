# Universo observável do /update e do noturno.
# Fonte não listada aqui NÃO é puxada — sem exceção.
# Leituras passam pelos MCPs do agente; o resultado cai na inbox via:
#   ./brain snapshot --key <key> --prefix <kind>
# Hash idêntico ao último pull da mesma key = silêncio (nada escrito).

# [[source]]
# key = "gcal-primary"
# kind = "gcal"
# window = "14d"
# note = "agenda ocupada — alimenta o planejador de foco"

# [[source]]
# key = "gmail-today"
# kind = "gmail"
# window = "1d"
# note = "digest do dia"

# [[source]]
# key = "slack-time-dados"
# kind = "slack"
# channel = "#time-dados"
# window = "1d"

# Pasta do Drive: cada arquivo e subpasta tem hash próprio (`snapshot --item … --rev …`);
# só o que mudou entra na inbox. Ver commands/drive/SKILL.md.
# [[source]]
# key = "drive-reunioes"
# kind = "drive"
# folder = "<id da pasta>"
# window = "1d"

# [[source]]
# key = "jira-me"
# kind = "jira"
# jql = "assignee = currentUser() AND updated >= -1d"

# Clones git locais: o CLI lê (`./brain repos pull github-repos`), não o MCP. `git fetch` em cada repo antes
# (só baixa; `fetch = "false"` desliga); 1ª leitura = o repo inteiro, depois só commit novo → RAW/…/github/.
# [[source]]
# key = "github-repos"
# kind = "github"
# path = "~/Github/"

# Playbook de um processo (Portfólio): o /update só relê o doc quando o modifiedTime muda.
# Normalmente criada por `./brain doc link PROC-0001 --kind playbook --ref <url|id> --watch`.
# [[source]]
# key = "playbook-proc-0001"
# kind = "drive-doc"
# doc = "<id do doc no Drive>"
# link = "PROC-0001"
