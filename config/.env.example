# Second Brain — credenciais dos conectores (INSTÂNCIA, nunca commitar)
# Copie para config/.env · chmod 600 config/.env
# TODOS os tokens devem ser READ-ONLY. O cérebro nunca escreve em ferramenta externa.

# --- Jira (API token: id.atlassian.net → Security → API token) ---
JIRA_BASE_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=voce@empresa.com
JIRA_TOKEN=xxxx

# --- GitHub (Fine-grained PAT: somente leitura nos repos que listar) ---
GITHUB_TOKEN=github_pat_xxx

# --- Slack (App OAuth token — escopos: channels:history, users:read,
#     conversations:read; DMs exigem im:history — ver scripts/connectors/README) ---
SLACK_TOKEN=xoxp-xxxx

# --- Google (Gmail + Drive) — OAuth read-only, guia: guides/google-oauth.md ---
# 1) Crie o OAuth client (tipo "Desktop app") no GCP e publique em produção
# 2) python3 scripts/connectors/google_auth.py  → autoriza 1× no navegador
# 3) Cole o refresh token impresso abaixo:
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=xxxx
# Backup do vault (semanal, domingo — ver guides/backup.md): escopo extra drive.file
# + id da pasta de destino (da URL: drive.google.com/drive/folders/<ID>)
GOOGLE_BACKUP_FOLDER_ID=xxxx
