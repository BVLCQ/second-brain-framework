# Copiado para config/brain.toml no `./brain init` (esse arquivo NÃO vai pro git).
# Chaves omitidas herdam o padrão de brainlib/config.py.

[owner]
id = "eu"
name = "Dono do cérebro"

# Fuso usado em prazos, foco e "hoje".
# timezone = "America/Sao_Paulo"

[work]
days = [1, 2, 3, 4, 5]          # ISO: 1=segunda … 7=domingo
start = "09:00"
end = "18:00"
lunch = "12:00-13:00"           # "" desliga

# Folgas / férias: o planejador de foco não agenda nestes dias.
# [[vacations]]
# start = "2026-12-24"
# end = "2027-01-04"

[focus]
mode = "ics"                    # "ics" (arquivo) | "google" (porta do calendário)
calendar = "primary"
horizon_days = 7
block_min = 30
block_max = 120
daily_max_min = 180
buffer_min = 10
default_effort_min = 60
title_prefix = "Foco"
decline_message = "Em bloco de foco planejado."

[outbound]
# Destinatários permitidos: ids de pessoa do ledger ou #canal.
allow = []
daily_max = 10

[publish]
# Destinos do espaço do time. Cada publicação exige aprovação explícita.
# Exemplos: "slack:#seu-canal" · "drive:<folder-id>"
destinations = []

[oppdrive]
# Porta 6: pastas de oportunidade no Google Drive. Ligada, o agente cria uma subpasta por OPP dentro de `root`
# e o one-pager (Google Doc) uma vez. O Resumo (tabelas) segue o Brain: o agente reescreve só os intervalos brain:*;
# o Detalhamento é de quem edita — ali o agente só deixa SUGESTÕES (Docs writeMode=SUGGEST). Cada pasta tem ainda
# uma subpasta "Fontes" com cópia dos documentos-fonte (reunião, Slack e nota nunca sobem).
enabled = false
root = ""                       # id ou URL da pasta-raiz ("Oportunidades")
# Ferramentas MCP da porta para o agente headless (noturno e TUI), no formato `mcp__<servidor>__<ferramenta>`:
# a de criar arquivo do Drive, a de ler/atualizar doc do Docs e a de busca. `brain agent allow` não libera escrita
# externa — só esta lista, editada à mão pelo dono.
tools = []
# sources_skip = ["*.csv"]      # documentos que nunca sobem para a pasta Fontes (glob no nome do arquivo)

# [oppdrive.brand]                # cores e fonte das tabelas do one-pager (hex sem #)
# header = "1F3A5F"
# border = "CCCCCC"
# font = "Arial"

[feedback]
# Porta 7: sugestões e bugs do próprio cérebro viram issues no repo público do framework.
# Título "[sugestão] Título" / "[bug] Título" + label do tipo. O texto é público: a porta recusa
# título/corpo com dado do dono (mesmas regras da varredura do upstream). No noturno nada é publicado.
# Token (permissão de criar issues no repo) vai em config/.env: GITHUB_TOKEN=…
repo = "BVLCQ/second-brain-framework"

[memory]
# Modos (guides/memory.md): none · embed (dois bancos de chunks, zero LLM, nada sai da máquina)
# · full (banco único com extração de fatos, observações e mental models — envia texto do vault
# à API de LLM com a CHAVE DO DONO no config/.env; exige cloud_llm = true).
engine = "none"                 # "hindsight" quando o servidor estiver no ar
url = "http://localhost:8888"
bank = "brain"                  # banco único nos dois modos, embed e full (decisão 8)
harness_bank = "hermes"         # banco dos agentes de código (fora do memory rebuild)
harnesses = []                  # cablados pelo wizard/CLI: claude-code, cursor-cli, codex, hermes
# raw_bank/mem_bank (brain-raw/brain-mem) são legados dos dois bancos antigos do embed:
# nada lê — `brain memory rebuild` os apaga do servidor ao consolidar no `bank`
max_file_mb = 25
extract = false                 # full: extração de fatos do RAW com contexto do ledger
cloud_llm = false               # true = o dono ativou o envio à própria API (plano da memória §4.3)
mental_models = false           # Fase 8 do plano — ainda não aterrissado
raw_awaiting_dump = "degraded"  # embed: entra com contexto degradado · full: "hold" (espera o /dump)
exclude_types = ["connectors", "github"]   # tipos do RAW que nunca vão ao banco

[runner]
agent = "auto"                  # auto | cursor | claude | codex | agy | gemini | none
command = ""                    # se preenchido, substitui o preset (use {prompt})
prompt = "/update"
timeout_min = 45
model = "claude-haiku-5-5"      # modelo do claude no noturno; vazio = padrão do claude
# Ferramentas MCP de LEITURA que o agente headless pode usar (noturno e TUI), no formato do claude
# (`mcp__<servidor>__<ferramenta>`). Sem isto o `claude -p` não tem como pedir permissão e as fontes são negadas.
allow = []

[tui]
# Ferramentas EXTRAS que o agente (claude) pode usar só nas ações ⚡ do `brain tui` — por exemplo as
# ferramentas de ESCRITA do MCP do Slack, só para enviar uma mensagem já aprovada. Vazio = só [runner].allow.
# `brain agent allow "<regra>" [--scope tui|runner]` grava aqui (ou em [runner].allow) uma permissão que o agente pediu e foi negada —
# nunca de MCP de escrita no mundo exterior: isso é a porta (/outbox, /publish), com o seu gate.
agent_allow = []
# Modelo e esforço do claude nas ações ⚡ do TUI (o noturno não usa). Vazio = padrão do claude.
model = "claude-haiku-5-5"     # vazio = padrão do claude; alias ("haiku") o claude resolve — pode cair numa geração antiga
effort = ""                    # low | medium | high | xhigh | max

[tui.open]
# Aplicativo que abre o arquivo clicado no detalhe ("Arquivos linkados", notas, documentos): extensão sem ponto = nome do app.
# Vazio = programa padrão do sistema (macOS: open -a <app>; Linux: o comando).
# md = "Cursor"
# mp4 = "VLC"

[backup]
enabled = false
max_file_mb = 50                # arquivos maiores entram só no manifesto
keep = 8
weekday = 7                     # ISO: 7 = domingo
