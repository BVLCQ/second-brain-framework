<?xml version="1.0" encoding="UTF-8"?>
<!-- Second Brain — agendamento noturno do /update (macOS launchd).

INSTALAÇÃO (na SUA instância, não no repo):
  1. Copie este arquivo para ~/Library/LaunchAgents/com.second-brain.nightly.plist
  2. Substitua /Users/EXEMPLO/brain pelo caminho real da sua instância
     (2 lugares: o script e o log de bootstrap)
  3. Ative:   launchctl load ~/Library/LaunchAgents/com.second-brain.nightly.plist
     Desative: launchctl unload ~/Library/LaunchAgents/com.second-brain.nightly.plist

O log da noite vai para vault/logs/nightly.log (dentro da zona cega do git —
o output pode citar emails/cards seus). O StandardOutPath abaixo é só
bootstrap: captura o caso raro do script nem chegar a rodar.
Linux/cron: `0 5 * * * /bin/bash /caminho/da/instancia/scripts/nightly-update.sh`
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.second-brain.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/EXEMPLO/brain/scripts/nightly-update.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/second-brain-nightly-bootstrap.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/second-brain-nightly-bootstrap.log</string>
</dict>
</plist>
